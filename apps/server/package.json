{
	"name": "server",
	"version": "1.0.0",
	"description": "",
	"main": "index.js",
	"scripts": {
		"dev": "tsx watch --env-file=.env src/index.ts",
		"build": "tsc -p tsconfig.build.json && cp -R src/db/drizzle dist/db/drizzle",
		"typecheck": "tsc --noEmit",
		"start": "node --env-file=.env dist/index.js",
		"test": "vitest run",
		"db:studio": "drizzle-kit studio --config=src/db/drizzle.config.ts",
		"db:generate": "drizzle-kit generate --config=src/db/drizzle.config.ts",
		"db:migrate": "drizzle-kit migrate --config=src/db/drizzle.config.ts"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"type": "module",
	"dependencies": {
		"@fastify/static": "10.1.10",
		"@fastify/websocket": "11.3.7",
		"@trpc/server": "11.28.0",
		"better-sqlite3": "13.0.3",
		"drizzle-orm": "0.45.4",
		"fastify": "5.12.8",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@types/better-sqlite3": "9.6.0",
		"@types/node": "26.6.6",
		"drizzle-kit": "0.31.11",
		"pino-pretty": "13.2.0",
		"tsx": "4.23.15",
		"typescript": "7.0.2",
		"vitest": "5.1.0"
	}
}
